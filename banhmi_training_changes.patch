+def _device_generator(device: torch.device, seed: int) -> torch.Generator:
+    generator = torch.Generator(device=device)
+    generator.manual_seed(seed)
+    return generator
+
+
+def _write_wav(path: Path, audio: torch.Tensor, sample_rate: int) -> None:
+    values = audio.detach().float().flatten().clamp(-1.0, 1.0)
+    pcm = (values * 32767.0).round().to(torch.int16).cpu().numpy().tobytes()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with wave.open(str(path), "wb") as output:
+        output.setnchannels(1)
+        output.setsampwidth(2)
+        output.setframerate(sample_rate)
+        output.writeframes(pcm)
+
+
+def _mean_metrics(metrics: Iterable[dict[str, float]]) -> dict[str, float]:
+    rows = list(metrics)
+    if not rows:
+        raise ValueError("validation produced no metrics")
+    keys = rows[0].keys()
+    return {key: sum(row[key] for row in rows) / len(rows) for key in keys}
