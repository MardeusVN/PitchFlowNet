+def _mean_metrics(metrics: Iterable[dict[str, float]]) -> dict[str, float]:
+    rows = list(metrics)
+    if not rows:
+        raise ValueError("validation produced no metrics")
+    keys = rows[0].keys()
+    return {key: sum(row[key] for row in rows) / len(rows) for key in keys}
